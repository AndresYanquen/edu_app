DATABASE_URL=postgres://user:password@127.0.0.1:5432/academy
JWT_SECRET=replace-with-strong-secret
PORT=3000
ACCESS_TOKEN_TTL_MIN=10
REFRESH_TOKEN_TTL_DAYS=14
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PRESENCE_ONLINE_TTL_SECONDS=120
QUENTLI_API_URL=https://api.quentli.com
QUENTLI_API_TOKEN=

# Upload limits in MB
MAX_IMAGE_UPLOAD_MB=10
MAX_DOCUMENT_UPLOAD_MB=25
MAX_AUDIO_UPLOAD_MB=50
VITE_MAX_IMAGE_UPLOAD_MB=10
VITE_MAX_DOCUMENT_UPLOAD_MB=25
VITE_MAX_AUDIO_UPLOAD_MB=50
IMAGE_MAX_WIDTH=1600
IMAGE_WEBP_QUALITY=82

# Optional: Cloudflare R2 direct uploads
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGNED_TTL_SECONDS=300
R2_DOWNLOAD_TTL_SECONDS=300
